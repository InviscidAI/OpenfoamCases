FoamFile { version 2.0; format ascii; class volScalarField; location "0"; object omega; }

dimensions      [0 0 -1 0 0 0 0];
internalField   uniform 160;
boundaryField
{
    "(left|right)"  { type inletOutlet; inletValue uniform 160; value uniform 160; }
    walls           { type omegaWallFunction; value uniform 160; }
    frontAndBack    { type empty; }
}
