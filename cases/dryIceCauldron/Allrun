#!/bin/bash
# A dry-ice cauldron in a living room, the front door shut or open to a still 10 C evening,
# 0-600 s from the moment the dry ice goes in.
#
#   ./Allrun shut|open|raised [nProcs]
#   ./Allrun --setup-only shut|open|raised [nProcs]
#
# shut     the front door shut: a baffle across the doorway at the wall's inside face.
# open     the front door open, its leaf left out as if swung back against the wall.
# raised   shut, with the cauldron on a 36 in (0.91 m) counter-height table in place of the
#          18 in coffee table; nothing else changes.
# nProcs   MPI ranks, default 8 (shut and open were solved on 8; raised, and shut again beside
#          it, on 2).
# --setup-only writes the run, meshes it, sets its zones and fields, checks and decomposes it,
#          and stops before the solve.
#
# scripts/make_case.py writes every dictionary, the initial fields and an Allrun into
# runs/<run>/; that Allrun meshes (blockMesh, then subsetMesh to the room, the doorway and the
# outdoor air), adds the cauldron's water surface, the ceiling leak, the furniture and, shut
# or raised, the door as patches, sets the zones and fields, writes the barometric pressure into the
# cells and the open faces (hydrostatic.py), checks and decomposes the run, and, given `solve`,
# runs rhoReactingBuoyantFoam. The planes at t = 0 come from the initial fields
# (system/planesT0).
cd "${0%/*}" || exit 1
set -euo pipefail
command -v blockMesh > /dev/null || { echo "source OpenFOAM's etc/bashrc first (v2512)" >&2; exit 1; }

setupOnly=false
if [ "${1:-}" = "--setup-only" ]; then setupOnly=true; shift; fi
run=${1:-}; nproc=${2:-8}
case "$run" in
  shut|open|raised) ;;
  *) echo "usage: $0 [--setup-only] shut|open|raised [nProcs]" >&2; exit 2 ;;
esac

r=runs/$run
rm -rf "$r"; mkdir -p runs
python3 scripts/make_case.py "$run" "$r" --nprocs "$nproc"
(cd "$r" && ./Allrun)
grep -E '^ +cells:|Mesh OK|Failed' "$r/log.checkMesh"
$setupOnly && { echo "set up, not solved: $r"; exit 0; }

cd "$r"
postProcess -dict system/planesT0 -fields '(T U CO2 O2)' -time 0 > log.postProcess.planesT0 2>&1
./Allrun solve
echo "solved: $r"
