// -------------------------------------------------------------------------
// caseSettings - the one settings file both runs, bare and cover, read.
// Every dictionary #includes it as ../../../config/caseSettings from
// runs/<run>/<dir>/. Nothing in it differs between the runs; the cover is in
// the mesh and in 0/T, which scripts/make_case.py writes.
// -------------------------------------------------------------------------

// ---- temperatures ---------------------------------------------------------
Tamb            289.15;     // 20 C : initial air, ceiling and inner wall
Tout            273.15;     // 0 C  : outside air on the far side of the glass

// ---- glass ----------------------------------------------------------------
// Overall U = 2.8 W/m2K including the inside surface film (Rsi = 0.13 m2K/W).
// Resistance left for the external BC: 1/2.8 - 0.13 = 0.2271 m2K/W
// -> external coefficient h = 4.403 W/m2K. The inside film, convection and
// radiation, is the solver's.
hGlassExt       4.403;

// ---- time -----------------------------------------------------------------
tEnd            300;        // from switch-on to 300 s
maxCoNum        1;
maxDt           0.25;

// ---- the convector's fin channels -------------------------------------------
// The upward Darcy resistance (1/m2) of the convector zone, constant/fvOptions:
// d = (1e8 dy 1e8). The one fitted setting: bare pilots, 0-40 s, matched to
// Stelrad's 980 W at dT50 scaled by EN 442's exponent 1.3 at the room's mean
// temperature over 25-40 s (README.md, "The one fitted setting"). Frozen for
// both runs.
dy 325267.206791;
fy 1.308411;
hv 448.85495029225507;

// ---- SHARED NUMERICS ----
sharedSolution
{

solvers
{
 "(Ii|ILambda.*)" { solver smoothSolver; smoother symGaussSeidel; tolerance 1e-7; relTol 0; maxIter 100; }
    "rho.*"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       0;
        relTol          0;
    }
    p_rgh
    {
        solver          GAMG;
        smoother        DICGaussSeidel;
        tolerance       1e-8;
        relTol          0.01;
    }
    p_rghFinal
    {
        $p_rgh;
        relTol          0;
        // Kept from radiatorUnderWindow, where the final pressure solve stalled at
        // its round-off floor just above the 1e-8 tolerance and spent 1000
        // iterations a step there.
        maxIter         100;
    }
    "(U|h|e|k|omega)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-7;
        relTol          0.1;
    }
    "(U|h|e|k|omega)Final"
    {
        $U;
        relTol          0;
    }
}

PIMPLE
{
    momentumPredictor           yes;
    nOuterCorrectors            2;
    nCorrectors                 2;
    nNonOrthogonalCorrectors    0;
    // Kept from radiatorUnderWindow: the pressure reference in the middle of
    // the room, not at a corner cell, whose continuity imbalance acted there
    // as a heat source with the floor adiabatic.
    pRefPoint                   (2.5 1.65 0.5);
    pRefValue                   1e5;
}

relaxationFactors
{
    equations
    {
        ".*"    1;
    }
}

}

// ---- SHARED NUMERICS ----
sharedSchemes
{

ddtSchemes      { default Euler; }
gradSchemes     { default Gauss linear; }

divSchemes
{
 div(Ji,Ii_h) Gauss upwind;
    default         none;
    div(phi,U)      Gauss limitedLinearV 1;
    energy          Gauss limitedLinear 1;
    div(phi,h)      $energy;
    div(phi,e)      $energy;
    div(phi,K)      Gauss linear;
    div(phi,Ekp)    Gauss linear;
    turbulence      Gauss limitedLinear 1;
    div(phi,k)      $turbulence;
    div(phi,omega)  $turbulence;
    div(((rho*nuEff)*dev2(T(grad(U))))) Gauss linear;
}

laplacianSchemes    { default Gauss linear corrected; }
interpolationSchemes{ default linear; }
snGradSchemes       { default corrected; }

wallDist
{
    method meshWave;
}

}

