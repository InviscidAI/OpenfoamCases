FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     pimpleFoam;

startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         180;

deltaT          0.001;
adjustTimeStep  yes;
maxCo           0.15;
maxDeltaT       0.001;

writeControl    runTime;
writeInterval   1;
purgeWrite      2;

writeFormat     binary;
writePrecision  10;
timeFormat      general;
timePrecision   8;

runTimeModifiable true;

functions
{
    forceCoeffs
    {
        type            forceCoeffs;
        libs            (forces);
        patches         (cylinder);
        rho             rhoInf;
        rhoInf          1;
        CofR            (0 0 1.5707963267949);
        liftDir         (0 1 0);
        dragDir         (1 0 0);
        pitchAxis       (0 0 1);
        magUInf         1;
        lRef            1;
        Aref            3.14159265358979;
        executeControl  timeStep;
        executeInterval 1;
        writeControl    timeStep;
        writeInterval   1;
    }

    probes
    {
        type            probes;
        libs            (sampling);
        fields          (U p);
        probeLocations
        (
            (1.5 0 1.5707963267949)
            (2 0 1.5707963267949)
            (3 0 1.5707963267949)
            (5 0 1.5707963267949)
            (7 0 1.5707963267949)
            (10 0 1.5707963267949)
        );
        executeControl  timeStep;
        executeInterval 1;
        writeControl    timeStep;
        writeInterval   1;
    }

    fieldAverage
    {
        type            fieldAverage;
        libs            (fieldFunctionObjects);
        timeStart       150;
        fields
        (
            U
            {
                mean        on;
                prime2Mean  on;
                base        time;
            }
            p
            {
                mean        on;
                prime2Mean  on;
                base        time;
            }
        );
        executeControl  timeStep;
        executeInterval 1;
        writeControl    writeTime;
    }

    yPlus
    {
        type            yPlus;
        libs            (fieldFunctionObjects);
        executeControl  writeTime;
        writeControl    writeTime;
        writeFields     yes;
    }
}
