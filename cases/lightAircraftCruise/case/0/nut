/*--------------------------------*- C++ -*----------------------------------*\
| lightAircraftCruise: half model, steady incompressible RANS                 |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/system/flightCondition"

dimensions      [0 2 -1 0 0 0 0];
internalField   uniform 0;

boundaryField
{
    "(inlet|outlet|side|bottom|top)"
    {
        type            calculated;
        value           uniform 0;
    }
    symmetry
    {
        type            symmetry;
    }
    "(wing|fuselage|tailplane|fin)"
    {
        type            nutUSpaldingWallFunction;
        value           uniform 0;
    }
}
