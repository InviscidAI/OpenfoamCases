/*--------------------------------*- C++ -*----------------------------------*\
| lightAircraftCruise: half model, steady incompressible RANS                 |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Cell sizes from the 2 m background: level 1 = 1 m, 2 = 0.5 m, 3 = 0.25 m,
// 4 = 0.125 m, 5 = 62.5 mm, 6 = 31.3 mm, 7 = 15.6 mm.
castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    wing.stl      { type triSurfaceMesh; name wing; }
    fuselage.stl  { type triSurfaceMesh; name fuselage; }
    tailplane.stl { type triSurfaceMesh; name tailplane; }
    fin.stl       { type triSurfaceMesh; name fin; }

    far    { type searchableBox; min (-6 0 -5);     max (30 10 6); }
    near   { type searchableBox; min (-2 0 -2.2);   max (16 6.4 3); }
    close  { type searchableBox; min (-0.6 0 -0.9); max (11 5.4 1.9); }
    // The starboard tip's vortex, carried aft and up by the inflow.
    tipWake { type searchableBox; min (3.3 4.1 -0.35); max (11 5.3 0.75); }
}

castellatedMeshControls
{
    maxLocalCells   4000000;
    maxGlobalCells  8000000;
    minRefinementCells 10;
    maxLoadUnbalance 0.10;
    nCellsBetweenLevels 3;

    features
    (
        { file "wing.eMesh";      level 7; }
        { file "tailplane.eMesh"; level 7; }
        { file "fin.eMesh";       level 7; }
        { file "fuselage.eMesh";  level 6; }
    );

    refinementSurfaces
    {
        wing      { level (7 7); patchInfo { type wall; } }
        tailplane { level (6 7); patchInfo { type wall; } }
        fin       { level (6 7); patchInfo { type wall; } }
        fuselage  { level (6 6); patchInfo { type wall; } }
    }

    resolveFeatureAngle 20;

    refinementRegions
    {
        far     { mode inside; levels ((1e15 2)); }
        near    { mode inside; levels ((1e15 3)); }
        close   { mode inside; levels ((1e15 4)); }
        tipWake { mode inside; levels ((1e15 5)); }
    }

    locationInMesh (-10.1 10.1 10.1);
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch    3;
    tolerance       2.0;
    nSolveIter      50;
    nRelaxIter      5;
    nFeatureSnapIter 10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

// Prism layers sized in metres: the first cell 0.7 mm off the wall, about y+ 70 at
// 45 m/s on these chords, for wall functions.
addLayersControls
{
    relativeSizes   false;
    firstLayerThickness 0.0007;
    expansionRatio  1.3;
    minThickness    0.0001;

    layers
    {
        wing      { nSurfaceLayers 6; }
        tailplane { nSurfaceLayers 6; }
        fin       { nSurfaceLayers 6; }
        fuselage  { nSurfaceLayers 6; }
    }

    nGrow           0;
    featureAngle    130;
    slipFeatureAngle 30;
    nRelaxIter      5;
    nSmoothSurfaceNormals 1;
    nSmoothNormals  3;
    nSmoothThickness 10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle 90;
    nBufferCellsNoExtrude 0;
    nLayerIter      50;
    nRelaxedIter    20;
}

meshQualityControls
{
    #include "meshQualityDict"
}

writeFlags ( scalarLevels layerSets layerFields );
mergeTolerance 1e-6;
