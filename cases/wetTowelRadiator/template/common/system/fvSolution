FoamFile { version 2.0; format ascii; class dictionary; object fvSolution; }


solvers
{
 Yi {solver PBiCGStab; preconditioner DILU; tolerance 1e-8; relTol 0.01;}
 YiFinal {$Yi; relTol 0;}
 "(Ii|ILambda.*)" { solver smoothSolver; smoother symGaussSeidel; tolerance 1e-7; relTol 0; maxIter 100; }
    "rho.*"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       0;
        relTol          0;
    }
    p_rgh
    {
        solver          GAMG;
        smoother        DICGaussSeidel;
        tolerance       1e-8;
        maxIter 100;
        relTol          0.01;
    }
    p_rghFinal
    {
        $p_rgh;
        relTol          0;
        // Kept from radiatorUnderWindow, where the final pressure solve stalled at
        // its round-off floor just above the 1e-8 tolerance and spent 1000
        // iterations a step there.
        maxIter         100;
    }
    "(U|h|e|k|omega)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-7;
        relTol          0.1;
    }
    "(U|h|e|k|omega)Final"
    {
        $U;
        relTol          0;
    }
}

PIMPLE
{
    momentumPredictor           yes;
    nOuterCorrectors            2;
    nCorrectors                 2;
    nNonOrthogonalCorrectors    0;
    // Kept from radiatorUnderWindow: the pressure reference in the middle of
    // the room, not at a corner cell, whose continuity imbalance acted there
    // as a heat source with the floor adiabatic.
    pRefPoint                   (1.503 1.174 0.5);
    pRefValue                   1e5;
}

relaxationFactors
{
    equations
    {
        ".*"    1;
    }
}

