/*--------------------------------*- C++ -*----------------------------------*\
| lightAircraftCruise: half model, steady incompressible RANS                 |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/system/flightCondition"

dimensions      [0 0 -1 0 0 0 0];
internalField   uniform $omegaInf;

boundaryField
{
    "(inlet|outlet|side|bottom|top)"
    {
        type            inletOutlet;
        inletValue      uniform $omegaInf;
        value           uniform $omegaInf;
    }
    symmetry
    {
        type            symmetry;
    }
    "(wing|fuselage|tailplane|fin)"
    {
        type            omegaWallFunction;
        value           uniform $omegaInf;
    }
}
