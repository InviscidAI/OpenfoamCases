FoamFile
{ version 2.0; format ascii; class dictionary; object controlDict; }
application pimpleFoam;
libs (utilityFunctionObjects forces sampling);
startFrom latestTime;
startTime 3.399976553327491;
stopAt endTime;
endTime 8.0;
deltaT 0.0003;
adjustTimeStep yes;
maxCo 0.8;
maxDeltaT 0.001;
writeControl adjustableRunTime;
writeInterval 0.2;
purgeWrite 0;
writeFormat binary;
writePrecision 8;
writeCompression off;
timeFormat general;
timePrecision 15;
runTimeModifiable true;
profiling { active true; cpuInfo false; memInfo false; sysInfo false; }
