    }
    panelGrid
    {
        type sets; libs (sampling); writeControl adjustableRunTime;
        writeInterval 0.00833333333333333; timeStart 4.0;
        setFormat vtk; interpolationScheme cell; fields (U riderKmask);
        formatOptions { vtk { format binary; } }
        sets
        {
            panel
            {
                type array; axis xyz; origin (-42.05 -6.05 1.25);
                rotation { type axes; e1 (1 0 0); e2 (0 1 0); }
                pointsDensity (1581 201 1); spanBox (79.1 10.1 0.1);
            }
        }
    }

}
