 reduce(sm,sumOp<scalar>());reduce(st,sumOp<scalar>());reduce(rv,sumOp<scalar>());reduce(rt,sumOp<scalar>());reduce(tlo,minOp<scalar>());reduce(thi,maxOp<scalar>());reduce(backA,sumOp<scalar>());reduce(backT,sumOp<scalar>());
