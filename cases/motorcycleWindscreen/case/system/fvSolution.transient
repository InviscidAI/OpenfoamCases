FoamFile { format ascii; class dictionary; object fvSolution; }
solvers
{
 p { solver GAMG; smoother GaussSeidel; tolerance 1e-6; relTol 0.05; cacheAgglomeration true; agglomerator faceAreaPair; nCellsInCoarsestLevel 20; }
 pFinal { $p; relTol 0; }
 U { solver smoothSolver; smoother symGaussSeidel; tolerance 1e-6; relTol 0.1; }
 UFinal { $U; relTol 0; }
 "(k|omega)" { solver smoothSolver; smoother symGaussSeidel; tolerance 1e-6; relTol 0.1; }
 kFinal { $k; relTol 0; }
 omegaFinal { $omega; relTol 0; }
}
PIMPLE
{
 momentumPredictor yes;
 nOuterCorrectors 1;
 nCorrectors 2;
 nNonOrthogonalCorrectors 1;
 correctPhi yes;
}
