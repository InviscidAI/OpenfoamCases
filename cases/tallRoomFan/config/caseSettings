 if(!zone){rv+=rho[i]*v;rt+=rho[i]*v*T[i];tlo=min(tlo,T[i]);thi=max(thi,T[i]);if(c.y()<1.8){bm+=rho[i]*v;bt+=rho[i]*v*T[i];}else{am+=rho[i]*v;at+=rho[i]*v*T[i];}}
 forAll(levels,k)if(levels[k]>=c.y()-.5*dy[i]-1e-9&&levels[k]<c.y()+.5*dy[i]-1e-9){scalar len=max(scalar(0),min(c.x()+.5*dx[i],scalar(4.5))-max(c.x()-.5*dx[i],scalar(.5)));lw[k]+=len;ls[k]+=len*(T[i]+gt()[i].y()*(levels[k]-c.y()));}
 }
 for(label k=0;k<2;k++){vector loc(2.5,k==0?.1:3.2,.5);label id=m.findCell(loc);if(id>=0){probe[2*k]=T[id]+(gt()[id]&(loc-m.C()[id]));probe[2*k+1]=1;}}
 // Sum phi/rho on each individual face, not division by room-average density.
 const wordList fzn({"fan_radiatorOut","fan_radiatorIn","fan_ceilingOut","fan_ceilingIn"});
 forAll(fzn,k){label zi=m.faceZones().findZoneID(fzn[k]);if(zi<0)continue;const auto& z=m.faceZones()[zi];forAll(z,j){label f=z[j];scalar ph=0,dens=1,weight=1;if(f<m.nInternalFaces()){ph=phi[f];dens=rf()[f];}else{label b=m.boundaryMesh().whichPatch(f),l=f-m.boundaryMesh()[b].start();ph=phi.boundaryField()[b][l];dens=rf().boundaryField()[b][l];if(m.boundary()[b].coupled())weight=.5;}scalar q=weight*ph/dens*(z.flipMap()[j]?-1:1);if(q>=0)flow[2*k]+=q;else flow[2*k+1]-=q;}}
 auto levelFace=[&](const vector& c,const vector& sf,scalar ph,scalar dens,scalar weight){if(mag(c.y()-1.5)>1e-7||mag(sf.y())<SMALL)return;scalar length=mag(sf.y());scalar fraction=max(scalar(0),min(c.x()+.5*length,scalar(4.99))-max(c.x()-.5*length,scalar(.13)))/length;scalar q=weight*fraction*ph/dens*(sf.y()>0?1:-1);if(q>=0)flow[8]+=q;else flow[9]-=q;};
 forAll(m.neighbour(),f)levelFace(m.Cf()[f],m.Sf()[f],phi[f],rf()[f],1);
 const wordList walls({"glass","floor","ceiling","innerWall","outerWall"});scalarList storage(5,0),area(5,0),tsum(5,0),tmin(5,GREAT),tmax(5,-GREAT);
 forAll(m.boundary(),b){const auto& patch=m.boundary()[b];if(patch.type()=="empty")continue;if(patch.coupled()){forAll(patch,j)levelFace(m.Cf().boundaryField()[b][j],m.Sf().boundaryField()[b][j],phi.boundaryField()[b][j],rf().boundaryField()[b][j],.5);continue;}
 forAll(walls,k)if(patch.name()==walls[k]){const auto& tp=T.boundaryField()[b];const auto& a=m.magSf().boundaryField()[b];OStringStream os;tp.write(os);IStringStream is(os.str());dictionary d(is);label n=d.getOrDefault<label>("nLayers",0);scalar capacity=n?d.get<scalar>("rhoCp")*d.get<scalar>("thickness")/n:0;for(label l=0;l<n;l++){scalarField layer("layer"+Foam::name(l),d,patch.size());forAll(layer,j)storage[k]+=capacity*a[j]*(layer[j]-289.15);}forAll(tp,j){area[k]+=a[j];tsum[k]+=a[j]*tp[j];tmin[k]=min(tmin[k],tp[j]);tmax[k]=max(tmax[k],tp[j]);}}
 }
 forAll(flow,k)reduce(flow[k],sumOp<scalar>());forAll(ls,k){reduce(ls[k],sumOp<scalar>());reduce(lw[k],sumOp<scalar>());}forAll(probe,k)reduce(probe[k],sumOp<scalar>());
 forAll(storage,k){reduce(storage[k],sumOp<scalar>());reduce(area[k],sumOp<scalar>());reduce(tsum[k],sumOp<scalar>());reduce(tmin[k],minOp<scalar>());reduce(tmax[k],maxOp<scalar>());}
 reduce(rv,sumOp<scalar>());reduce(rt,sumOp<scalar>());reduce(bm,sumOp<scalar>());reduce(bt,sumOp<scalar>());reduce(am,sumOp<scalar>());reduce(at,sumOp<scalar>());reduce(tlo,minOp<scalar>());reduce(thi,maxOp<scalar>());
 if(Pstream::master()){fileName dir=m.time().globalPath()/"postProcessing/diagnostics66";mkDir(dir);static bool first=true;std::ofstream out((dir/"diagnostics.csv").c_str(),first?std::ios::out:std::ios::app);out<<std::setprecision(14);
 if(first){out<<"time,radOutPositive,radOutNegative,radInPositive,radInNegative,ceilOutPositive,ceilOutNegative,ceilInPositive,ceilInNegative,up_m3s,down_m3s,line010_K,line110_K,line150_K,line320_K,roomT_K,belowT_K,aboveT_K,probe010_K,probe320_K,airMin_K,airMax_K,deltaT_s,wall_s";forAll(walls,k)out<<","<<walls[k]<<"Storage_J,"<<walls[k]<<"Mean_K,"<<walls[k]<<"Min_K,"<<walls[k]<<"Max_K";out<<'\n';}
 out<<m.time().value();forAll(flow,k)out<<','<<flow[k];forAll(ls,k)out<<','<<ls[k]/max(lw[k],SMALL);out<<','<<rt/max(rv,SMALL)<<','<<bt/max(bm,SMALL)<<','<<at/max(am,SMALL)<<','<<probe[0]/max(probe[1],SMALL)<<','<<probe[2]/max(probe[3],SMALL)<<','<<tlo<<','<<thi<<','<<m.time().deltaTValue()<<','<<m.time().elapsedClockTime();forAll(walls,k)out<<','<<storage[k]<<','<<tsum[k]/max(area[k],SMALL)<<','<<tmin[k]<<','<<tmax[k];out<<'\n';first=false;}
