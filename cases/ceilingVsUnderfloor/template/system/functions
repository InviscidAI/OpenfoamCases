FoamFile { version 2.0; format ascii; class dictionary; object functions; }
// ---- every time step ------------------------------------------------------------
// the room's internal energy is (cv/R) times the integral of p dV for a perfect gas in a
// closed box (radiatorUnderWindow's energyCheck): the heat budget without the mean temperature
energyCheck
{
    type            volFieldValue;
    libs            (fieldFunctionObjects);
    fields          (p rho);
    operation       volIntegrate;
    regionType      all;
    writeFields     false;
    writeControl    timeStep;
    log             false;
}
roomMeanT
{
    type            volFieldValue;
    libs            (fieldFunctionObjects);
    regionType      all;
    operation       volAverage;
    fields          (T);
    writeFields     false;
    writeControl    timeStep;
    log             false;
}
// the occupied zone's mean air temperature in bands 0.04 m tall at 0.1, 0.6, 1.1 and
// 1.7 m (ASHRAE 55: 1.0 m from the window wall, 0.3 m from the others)
occ_ankle
{
    $roomMeanT;
    regionType      cellZone;
    name            occ_ankle;
}
occ_knee
{
    $roomMeanT;
    regionType      cellZone;
    name            occ_knee;
}
occ_head
{
    $roomMeanT;
    regionType      cellZone;
    name            occ_head;
}
occ_standing
{
    $roomMeanT;
    regionType      cellZone;
    name            occ_standing;
}
// the glass's and the floor's mean surface temperature; the glass's loss is
// 4.403 W/m2K times the area integral of (T - 273.15)
surfaceT
{
    type            surfaceFieldValue;
    libs            (fieldFunctionObjects);
    regionType      patch;
    name            glass;
    operation       areaAverage;
    fields          (T);
    writeFields     false;
    writeControl    timeStep;
    log             false;
}
glassIntT
{
    $surfaceT;
    operation       areaIntegrate;
}
floorT
{
    $surfaceT;
    name            floor;
}
floorTmax
{
    $surfaceT;
    name            floor;
    operation       max;
}
// the heat through every boundary, at the field writes only (see writeInterval)
wallHeatFlux
{
    type            wallHeatFlux;
    libs            (fieldFunctionObjects);
    writeControl    writeTime;
    log             false;
}
minMax
{
    type            fieldMinMax;
    libs            (fieldFunctionObjects);
    fields          (T U);
    writeControl    adjustableRunTime;
    writeInterval   1.25;
    log             false;
}
probes
{
    type            probes;
    libs            (sampling);
    fields          (T U);
    writeControl    adjustableRunTime;
    writeInterval   1.25;
    probeLocations
    (
        (0.5 0.1 0.005) (1.0 0.1 0.005) (2.0 0.1 0.005) (3.0 0.1 0.005)
        (1.0 1.1 0.005) (2.0 1.1 0.005) (3.0 1.1 0.005) (2.0 2.2 0.005)
    );
}

