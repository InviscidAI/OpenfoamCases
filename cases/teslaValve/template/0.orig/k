FoamFile { version 2.0; format ascii; class volScalarField; location "0"; object k; }

// 5% intensity at 0.5 m/s. inletOutlet holds the value where flow comes in, so the
// same entry serves both ends in either direction.
dimensions      [0 2 -2 0 0 0 0];
internalField   uniform 9.4e-04;
boundaryField
{
    "(left|right)"  { type inletOutlet; inletValue uniform 9.4e-04; value uniform 9.4e-04; }
    walls           { type kqRWallFunction; value uniform 9.4e-04; }
    frontAndBack    { type empty; }
}
