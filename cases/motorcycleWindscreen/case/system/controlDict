FoamFile { format ascii; class dictionary; object controlDict; }
application pimpleFoam;
startFrom startTime; startTime 0; stopAt endTime; endTime 1.2;
deltaT 0.0002083333333333333;
adjustTimeStep no; maxCo 1;
writeControl runTime; writeInterval 0.2; purgeWrite 2;
writeFormat binary; writeCompression off; timePrecision 9; runTimeModifiable false;
functions
{
 fieldAverage
 {
  type fieldAverage; libs (fieldFunctionObjects); timeStart 0.2;
  executeControl timeStep; executeInterval 1; writeControl onEnd;
  fields ( p { mean on; prime2Mean on; base time; } );
 }
 pRMS
 {
  type exprField; libs (fieldFunctionObjects); timeStart 0.2;
  field pRMS; useNamePrefix false;
  expression "sqrt(max(pPrime2Mean, 0*pPrime2Mean))";
  dimensions [0 2 -2 0 0 0 0];
  executeControl timeStep; executeInterval 1; writeControl onEnd;
 }
 centreline
 {
  type surfaces; libs (sampling); timeStart 0.2;
  writeControl timeStep; writeInterval 10;
  surfaceFormat vtk; fields (U p); interpolationScheme cellPoint;
  surfaces { y0 { type cuttingPlane; point (0 0 0); normal (0 1 0); interpolate true; } }
 }
 helmetMetric
 {
  type surfaceFieldValue; libs (fieldFunctionObjects); timeStart 0.2;
  writeControl onEnd; regionType patch; name helmet; operation areaAverage;
  fields (pRMS); writeFields no;
 }
 bikeEnd
 {
  type surfaces; libs (sampling); timeStart 0.2; writeControl onEnd;
  surfaceFormat vtk; fields (p pMean pPrime2Mean pRMS); interpolationScheme cell;
  surfaces { bikeSurface { type patch; patches (bike helmet screen); triangulate true; } }
 }
}
