FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 0 2 -3 0 0 0 0 ];

internalField   uniform 1e-05;

boundaryField
{
    fan
    {
        type            inletOutlet;
        inletValue      uniform 0.0027;
        value           uniform 1e-05;
    }
    vent
    {
        type            inletOutlet;
        inletValue      uniform 0.0027;
        value           uniform 1e-05;
    }
    walls
    {
        type            epsilonWallFunction;
        blending        stepwise;
        value           uniform 1e-05;
    }
    furniture
    {
        type            epsilonWallFunction;
        blending        stepwise;
        value           uniform 1e-05;
    }
    frontAndBack
    {
        type            empty;
    }
}

