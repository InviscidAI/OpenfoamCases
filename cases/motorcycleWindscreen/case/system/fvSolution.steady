FoamFile { format ascii; class dictionary; object fvSolution; }
solvers
{
 p { solver GAMG; smoother GaussSeidel; tolerance 1e-7; relTol 0.05; cacheAgglomeration true; agglomerator faceAreaPair; nCellsInCoarsestLevel 20; }
 U { solver smoothSolver; smoother symGaussSeidel; tolerance 1e-7; relTol 0.1; }
 "(k|omega)" { solver smoothSolver; smoother symGaussSeidel; tolerance 1e-7; relTol 0.1; }
}
SIMPLE { nNonOrthogonalCorrectors 1; consistent yes; }
relaxationFactors { fields { p 0.3; } equations { U 0.7; k 0.7; omega 0.7; } }
