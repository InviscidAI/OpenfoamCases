#!/bin/bash
# A Stelrad Compact K2 double panel radiator at 55 C under a tall window, bare and with a fan
# bar standing on its top grille blowing level into the room, a 2-D section of a 3.4 x 2.7 m
# study on a 0 C day, 0-300 s from switch-on at 16 C, with radiation.
#
#   ./Allrun bare|fan [nProcs]
#   ./Allrun --setup-only bare|fan [nProcs]
#
# bare          the radiator alone; the cells where the bar's housing would be are air.
# fan           the same radiator with the bar's housing on its top and its fan zone driven at
#               the calibrated Ubar (constant/fanSettings): 16.5-16.6 L/s per metre out of it.
# nProcs        MPI ranks; by default 7, what both solved runs used.
# --setup-only  compiles the wall condition if needed, writes the run, checks the mesh, writes
#               the t = 0 planes, decomposes the run and stops before the solve.
#
# Both runs go straight through from rest to 300 s. (The solved bare run was paused at 60 s and
# continued from there; README.md says how such a restart has to set the pressure reference.)
#
# Every wall but the radiator's panels and the bar's housing is radLayerWall (src/radLayerWall),
# compiled into $FOAM_USER_LIBBIN as libradLayerWall.so. scripts/make_case.py writes the run into
# runs/<run>/: the mesh with its cell and face zones (written directly, not by blockMesh), the
# hydrostatic 0/p and 0/p_rgh, and template/'s other fields and dictionaries. The dictionaries
# #include ../../../config/caseSettings and ../../../scripts/planeFunctions; caseSettings' coded
# function objects heatAccounting and diagnostics67 are compiled into the run's dynamicCode when
# the solve starts. When both runs have solved, scripts/extract_results.py writes results/.
cd "${0%/*}" || exit 1
set -euo pipefail
command -v buoyantPimpleFoam > /dev/null || { echo "source OpenFOAM's etc/bashrc first (v2512)" >&2; exit 1; }
command -v wmake > /dev/null || { echo "wmake is needed to compile src/" >&2; exit 1; }
python3 -c "import numpy" 2> /dev/null || { echo "python3 needs NumPy" >&2; exit 1; }

setupOnly=false
if [ "${1:-}" = "--setup-only" ]; then setupOnly=true; shift; fi
run=${1:-}
case "$run" in
  bare|fan) nproc=${2:-7} ;;
  *) echo "usage: $0 [--setup-only] bare|fan [nProcs]" >&2; exit 2 ;;
esac

# the wall condition (wmake does nothing if it is up to date)
wmake libso src/radLayerWall > log.wmake.radLayerWall 2>&1 || { echo "src/radLayerWall did not compile: log.wmake.radLayerWall" >&2; exit 1; }

r=runs/$run
mkdir -p runs
python3 scripts/make_case.py "$run" "$r" --nprocs "$nproc"
(
  cd "$r"
  checkMesh -constant > log.checkMesh 2>&1
  grep -q 'Mesh OK' log.checkMesh || { echo "$r: checkMesh failed, see log.checkMesh" >&2; exit 1; }
  grep -E '^ +cells:' log.checkMesh
  # the section and the glass at t = 0, before the solve writes its first (scripts/planeFunctions)
  postProcess -dict system/initialPlanes -time 0 -fields '(T U G qr)' > log.initialPlanes 2>&1
  decomposePar -fileHandler collated > log.decomposePar 2>&1
)
$setupOnly && { echo "set up, not solved: $r"; exit 0; }

(
  cd "$r"
  mpirun -np "$nproc" buoyantPimpleFoam -parallel -fileHandler collated > log.buoyantPimpleFoam 2>&1
  grep -q '^End' log.buoyantPimpleFoam || { echo "$r: the solve did not end, see log.buoyantPimpleFoam" >&2; exit 1; }
)
echo "solved: $r"
solved() { [ -f "runs/$1/log.buoyantPimpleFoam" ] && grep -q '^End' "runs/$1/log.buoyantPimpleFoam"; }
if solved bare && solved fan; then
  python3 scripts/extract_results.py runs results
fi
