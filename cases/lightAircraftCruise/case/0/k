/*--------------------------------*- C++ -*----------------------------------*\
| lightAircraftCruise: half model, steady incompressible RANS                 |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/system/flightCondition"

dimensions      [0 2 -2 0 0 0 0];
internalField   uniform $kInf;

boundaryField
{
    "(inlet|outlet|side|bottom|top)"
    {
        type            inletOutlet;
        inletValue      uniform $kInf;
        value           uniform $kInf;
    }
    symmetry
    {
        type            symmetry;
    }
    "(wing|fuselage|tailplane|fin)"
    {
        type            kqRWallFunction;
        value           uniform $kInf;
    }
}
