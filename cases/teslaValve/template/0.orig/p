FoamFile { version 2.0; format ascii; class volScalarField; location "0"; object p; }

// kinematic pressure, p/rho; Allrun replaces @UPSTREAM@ and @DOWNSTREAM@
dimensions      [0 2 -2 0 0 0 0];
internalField   uniform 0;
boundaryField
{
    @UPSTREAM@      { type zeroGradient; }
    @DOWNSTREAM@    { type fixedValue; value uniform 0; }
    walls           { type zeroGradient; }
    frontAndBack    { type empty; }
}
