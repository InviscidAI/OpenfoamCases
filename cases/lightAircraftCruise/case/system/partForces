FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      partForces;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

force_wing
{
    type            forces;
    libs            (forces);
    writeControl    timeStep;
    writeInterval   1;
    log             false;
    patches         (wing);
    rho             rhoInf;
    rhoInf          1.225;
    CofR            (3.2 0 0);
}

