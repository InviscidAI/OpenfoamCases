 out<<m.time().value();forAll(flow,k)out<<','<<flow[k];out<<','<<st/max(sm,SMALL)<<','<<rt/max(rv,SMALL)<<','<<tlo<<','<<thi<<','<<backT/max(backA,SMALL)<<','<<m.time().deltaTValue()<<','<<m.time().elapsedClockTime();forAll(walls,k)out<<','<<storage[k]<<','<<tsum[k]/max(area[k],SMALL)<<','<<tmin[k]<<','<<tmax[k];out<<'\n';first=false;
