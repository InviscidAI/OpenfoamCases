#!/bin/bash
# A small one-storey house with forced-air heating, warming from a 62 F night setback once the
# blower starts, with every floor register open or with the spare bedroom's register closed and
# its door shut, the whole house in 3-D from the blower's start to 300 s (buoyantPimpleFoam,
# k-omega SST).
#
#   ./Allrun open|closed [nProcs]
#   ./Allrun --setup-only open|closed [nProcs]
#
# open          all six registers blowing, with the duct calculation's flows and supply temperature.
# closed        the spare room's register a wall; the other five with the duct calculation's
#               larger flows and warmer supply.
# nProcs        MPI ranks; by default 8, what both solved runs used.
# --setup-only  compiles the wall condition if needed, builds the mesh if needed, writes the run,
#               writes the t = 0 planes, decomposes the run and stops before the solve.
#
# Both runs go straight through from rest to 300 s, as the solved runs did.
#
# Every wall, the floor, the ceiling and the windows are storedLayerWall (src/storedLayerWall),
# compiled into $FOAM_USER_LIBBIN as libstoredLayerWall.so. The mesh is shared: the first call
# builds it in runs/mesh/ (scripts/make_mesh.py, blockMesh, a serial snappyHexMesh of a few
# seconds, scripts/house_patches.py, checkMesh), so start the second run after the first has its
# mesh. scripts/make_case.py writes runs/<run>/ from it, template/ and config/case.json. The
# monitor is coded and compiled into the run's dynamicCode when the solve starts. When both runs
# have solved, scripts/extract_results.py writes results/. The registers' flows come from the
# duct calculation, scripts/ducts.py (its output is config/ducts.txt), which no step here runs.
cd "${0%/*}" || exit 1
set -euo pipefail
command -v buoyantPimpleFoam > /dev/null || { echo "source OpenFOAM's etc/bashrc first (v2512)" >&2; exit 1; }
command -v wmake > /dev/null || { echo "wmake is needed to compile src/" >&2; exit 1; }
python3 -c "import numpy" 2> /dev/null || { echo "python3 needs NumPy" >&2; exit 1; }

setupOnly=false
if [ "${1:-}" = "--setup-only" ]; then setupOnly=true; shift; fi
run=${1:-}
case "$run" in
  open|closed) nproc=${2:-8} ;;
  *) echo "usage: $0 [--setup-only] open|closed [nProcs]" >&2; exit 2 ;;
esac

# the wall condition (wmake does nothing if it is up to date)
wmake libso src/storedLayerWall > log.wmake.storedLayerWall 2>&1 \
  || { echo "src/storedLayerWall did not compile: log.wmake.storedLayerWall" >&2; exit 1; }

mesh=runs/mesh
mkdir -p runs
if [ ! -f "$mesh/cells.npz" ]; then
  rm -rf "$mesh"
  python3 scripts/make_mesh.py "$mesh"
  ( cd "$mesh" && blockMesh > log.blockMesh 2>&1 && snappyHexMesh -overwrite > log.snappyHexMesh 2>&1 ) \
    || { echo "$mesh: meshing failed, see its logs" >&2; exit 1; }
  python3 scripts/house_patches.py "$mesh" > "$mesh/log.housePatches" 2>&1 \
    || { rm -f "$mesh/cells.npz"; echo "$mesh: the house's patches did not sort, see log.housePatches" >&2; exit 1; }
  ( cd "$mesh" && checkMesh > log.checkMesh 2>&1 )
  grep -q 'Mesh OK' "$mesh/log.checkMesh" || { rm -f "$mesh/cells.npz"; echo "$mesh: checkMesh failed, see log.checkMesh" >&2; exit 1; }
  grep -E '^ +cells:' "$mesh/log.checkMesh"
fi

r=runs/$run
python3 scripts/make_case.py "$run" "$r" --nprocs "$nproc" --mesh "$mesh"
(
  cd "$r"
  # the three plans and three sections at t = 0, before the solve writes its first
  postProcess -dict system/planesT0 -time 0 -fields '(T U)' > log.planesT0 2>&1
  decomposePar -fileHandler collated > log.decomposePar 2>&1
)
$setupOnly && { echo "set up, not solved: $r"; exit 0; }

(
  cd "$r"
  mpirun -np "$nproc" buoyantPimpleFoam -parallel -fileHandler collated > log.buoyantPimpleFoam 2>&1
  grep -q '^End' log.buoyantPimpleFoam || { echo "$r: the solve did not end, see log.buoyantPimpleFoam" >&2; exit 1; }
)
echo "solved: $r"
solved() { [ -f "runs/$1/log.buoyantPimpleFoam" ] && grep -q '^End' "runs/$1/log.buoyantPimpleFoam"; }
if solved open && solved closed; then
  python3 scripts/extract_results.py runs results
fi
