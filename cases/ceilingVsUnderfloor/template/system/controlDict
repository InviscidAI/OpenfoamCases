FoamFile { version 2.0; format ascii; class dictionary; object controlDict; }
// ceilingVsUnderfloor, run RUN
application     buoyantPimpleFoam;
libs            ("libradLayerWall.so");
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         1200;
deltaT          0.005;
adjustTimeStep  yes;
maxCo           1;          // radiatorUnderWindow's and windowAiring's Courant number
maxDeltaT       0.1;
// full fields every 7.5 s, the last two kept: to continue an interrupted solve, and
// so wallHeatFlux, which writes into a time directory whenever it writes, gives the heat
// through each boundary every 7.5 s. The clip is the planes, every 2.5 s.
writeControl    adjustableRunTime;
writeInterval   7.5;
purgeWrite      2;
writeFormat     binary;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   8;
// never re-read while running: a re-read with surfaces planes can crash every rank
runTimeModifiable false;

functions
{
    #include "functions"
}
