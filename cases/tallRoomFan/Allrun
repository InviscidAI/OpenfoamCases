#!/bin/bash
# A tall Altbau room heated by a radiator under a box window, with no fan, with a small floor
# fan aimed at the ceiling and with the same fan aimed at the radiator, a 2-D section 5.0 x
# 3.3 m on a 0 C day, 0-300 s from switch-on, with radiation.
#
#   ./Allrun nofan|fan_ceiling|fan_radiator|bare [nProcs]
#   ./Allrun --setup-only nofan|fan_ceiling|fan_radiator|bare [nProcs]
#
# nofan         the radiator alone.
# fan_ceiling   the fan on the floor 1.0 m from the inner wall, blowing straight up.
# fan_radiator  the fan on the floor 0.83 m in front of the radiator, blowing at it. Kept, not
#               in the clip: its model radiator gains more than a real one (README.md).
# bare          nofan from rest to 40 s, no plane: the check of the convector's conductance hv
#               against the radiator's catalogue rating, used for nothing else.
# nProcs        MPI ranks; by default what each solved run used: nofan 3, fan_ceiling 7,
#               fan_radiator 5, bare 8.
# --setup-only  compiles the wall condition if needed, writes the run, checks the mesh, writes
#               the t = 0 plane (not bare), decomposes the run and stops before the solve.
#
# Every wall but the radiator's panel is radLayerWall (src/radLayerWall), compiled into
# $FOAM_USER_LIBBIN as libradLayerWall.so. scripts/make_case.py writes the run into
# runs/<run>/: the mesh with its cell and face zones (written directly, not by blockMesh), 0/T,
# 0/IDefault, the hydrostatic 0/p and 0/p_rgh, and template/'s other fields and dictionaries.
# Every dictionary #includes ../../../config/caseSettings, whose coded function objects
# heatAccounting and diagnostics66, and system/controlDict's convectorAir, OpenFOAM compiles
# into the run's dynamicCode when the solve starts. When nofan and fan_ceiling have solved,
# scripts/extract_results.py writes results/ (with fan_radiator and bare if they have run).
cd "${0%/*}" || exit 1
set -euo pipefail
command -v buoyantPimpleFoam > /dev/null || { echo "source OpenFOAM's etc/bashrc first (v2512)" >&2; exit 1; }
command -v wmake > /dev/null || { echo "wmake is needed to compile src/" >&2; exit 1; }
python3 -c "import numpy" 2> /dev/null || { echo "python3 needs NumPy" >&2; exit 1; }

setupOnly=false
if [ "${1:-}" = "--setup-only" ]; then setupOnly=true; shift; fi
run=${1:-}
case "$run" in
  nofan) nproc=${2:-3} ;;
  fan_ceiling) nproc=${2:-7} ;;
  fan_radiator) nproc=${2:-5} ;;
  bare) nproc=${2:-8} ;;
  *) echo "usage: $0 [--setup-only] nofan|fan_ceiling|fan_radiator|bare [nProcs]" >&2; exit 2 ;;
esac

# the wall condition (wmake does nothing if it is up to date)
wmake libso src/radLayerWall > log.wmake.radLayerWall 2>&1 || { echo "src/radLayerWall did not compile: log.wmake.radLayerWall" >&2; exit 1; }

r=runs/$run
mkdir -p runs
python3 scripts/make_case.py "$run" "$r" --nprocs "$nproc"
(
  cd "$r"
  checkMesh -constant > log.checkMesh 2>&1
  grep -q 'Mesh OK' log.checkMesh || { echo "$r: checkMesh failed, see log.checkMesh" >&2; exit 1; }
  grep -E '^ +cells:' log.checkMesh
  if [ "$run" != bare ]; then
    # the section at t = 0, before the solve writes its first (system/clip)
    postProcess -func clip -fields '(T U G qr)' -time 0 > log.initialPlane 2>&1
  fi
  decomposePar -fileHandler collated > log.decomposePar 2>&1
)
$setupOnly && { echo "set up, not solved: $r"; exit 0; }

(
  cd "$r"
  mpirun -np "$nproc" buoyantPimpleFoam -parallel -fileHandler collated > log.buoyantPimpleFoam 2>&1
  grep -q '^End' log.buoyantPimpleFoam || { echo "$r: the solve did not end, see log.buoyantPimpleFoam" >&2; exit 1; }
)
echo "solved: $r"
solved() { [ -f "runs/$1/log.buoyantPimpleFoam" ] && grep -q '^End' "runs/$1/log.buoyantPimpleFoam"; }
if solved nofan && solved fan_ceiling; then
  python3 scripts/extract_results.py runs results
fi
