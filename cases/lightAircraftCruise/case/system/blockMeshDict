/*--------------------------------*- C++ -*----------------------------------*\
| lightAircraftCruise: half model, steady incompressible RANS                 |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Half model: the aircraft's symmetry plane is y = 0. Nose at x = 0, 8 m fuselage.
// 2 m background cells, 3 fuselage lengths upstream, 7 downstream, 3 to the side,
// above and below.
scale 1;

vertices
(
    (-24  0 -24) (56  0 -24) (56 24 -24) (-24 24 -24)
    (-24  0  24) (56  0  24) (56 24  24) (-24 24  24)
);

blocks ( hex (0 1 2 3 4 5 6 7) (40 12 24) simpleGrading (1 1 1) );

boundary
(
    inlet    { type patch;    faces ((0 4 7 3)); }
    outlet   { type patch;    faces ((1 2 6 5)); }
    symmetry { type symmetry; faces ((0 1 5 4)); }
    side     { type patch;    faces ((3 7 6 2)); }
    bottom   { type patch;    faces ((0 3 2 1)); }
    top      { type patch;    faces ((4 5 6 7)); }
);
