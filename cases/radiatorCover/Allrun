#!/bin/bash
# A radiator under a cold window, bare, inside a wooden radiator cover, or with a sofa standing
# 15 cm in front of it, held at 55 C from switch-on to 300 s, in radiatorUnderWindow's room
# section with radiation; and the same radiator with an open fin-gap convector, bare or with
# small fans under it.
#
#   ./Allrun bare|cover|sofa|finsBare|finsFans [nProcs]
#   ./Allrun --setup-only bare|cover|sofa|finsBare|finsFans [nProcs]
#
# bare     the Stelrad K1's steel front panel and its convector, nothing round them.
# cover    the same radiator inside a B&Q horizontal-grill MDF cover: a solid top, a front
#          frame with a slotted grille, a 4 cm gap under it to the floor, no back.
# sofa     the bare radiator with an IKEA BACKSAELEN 3-seat sofa's side profile cut out of
#          the bare run's mesh 15 cm in front of it, the cells along the sofa refined twice,
#          the sofa's surface a thin layer of fabric over foam with heat capacity.
# finsBare the bare radiator with its convector changed: the upward resistance of a 6.31 mm
#          fin gap, its air heated by the fins through a fitted conductance instead of held
#          at 55 C (config/finsSettings).
# finsFans finsBare with a row of small fans under the radiator, a meanVelocityForce zone
#          driven at about the fans' rated 2 x 30 m3/h per metre.
# nProcs   MPI ranks, default 16 (all five solved runs used 16).
# --setup-only writes the run, checks the mesh, decomposes the run and writes the t = 0
#          plane, and stops before the solve.
#
# scripts/make_case.py writes the run into runs/<run>/: the mesh (written directly, not by
# blockMesh), 0/T with the cover's baffles or the sofa's shell, and template/'s other fields
# and dictionaries. Every dictionary #includes ../../../config/caseSettings, the sofa
# run's controlDict config/sofaSettings too, and the fins runs' controlDict and fvOptions
# config/finsSettings. When bare and cover have solved, scripts/extract_results.py writes
# results/, and results/sofa/ once sofa has solved too; when finsBare and finsFans have
# solved, results/finsBare/ and results/finsFans/.
cd "${0%/*}" || exit 1
set -euo pipefail
command -v buoyantPimpleFoam > /dev/null || { echo "source OpenFOAM's etc/bashrc first (v2512)" >&2; exit 1; }
python3 -c "import numpy" 2> /dev/null || { echo "python3 needs NumPy" >&2; exit 1; }

setupOnly=false
if [ "${1:-}" = "--setup-only" ]; then setupOnly=true; shift; fi
run=${1:-}; nproc=${2:-16}
case "$run" in
  bare|cover|sofa|finsBare|finsFans) ;;
  *) echo "usage: $0 [--setup-only] bare|cover|sofa|finsBare|finsFans [nProcs]" >&2; exit 2 ;;
esac

r=runs/$run
mkdir -p runs
python3 scripts/make_case.py "$run" "$r" --nprocs "$nproc"
if [ "$run" = sofa ]; then
  (
    cd "$r"
    # the fields wait while the mesh is cut and refined, so that no utility rewrites them
    mv 0 0.fields
    # the sofa's cells out, their faces the new patch sofa, made a wall
    topoSet -dict system/topoSetDict.sofa > log.topoSet.sofa 2>&1
    subsetMesh fluid -patch sofa -overwrite > log.subsetMesh.sofa 2>&1
    foamDictionary constant/polyMesh/boundary -entry entry0/sofa/type -set wall > /dev/null 2>&1
    foamDictionary constant/polyMesh/boundary -entry entry0/sofa/inGroups -set '1(wall)' > /dev/null 2>&1
    # split in x and y the cells owning a sofa face and every cell touching them, then the
    # cells owning a sofa face again
    topoSet -dict system/topoSetDict.nearLayer > log.topoSet.near1 2>&1
    refineMesh -dict system/refineMeshDict -overwrite > log.refineMesh1 2>&1
    topoSet -dict system/topoSetDict.near > log.topoSet.near2 2>&1
    refineMesh -dict system/refineMeshDict -overwrite > log.refineMesh2 2>&1
    rm -rf 0
    mv 0.fields 0
    # the sofa's shell: a finite-area mesh on the patch sofa
    makeFaMesh > log.makeFaMesh 2>&1
  )
fi
if [ "$run" = finsBare ] || [ "$run" = finsFans ]; then
  # the fan's cell zone and the face zones under the fan and at the convector's bottom and top
  (cd "$r" && topoSet -dict system/topoSetDict.fan > log.topoSet.fan 2>&1)
fi
(
  cd "$r"
  checkMesh -constant > log.checkMesh 2>&1
  grep -q 'Mesh OK' log.checkMesh || { echo "$r: checkMesh failed, see log.checkMesh" >&2; exit 1; }
  grep -E '^ +cells:' log.checkMesh
  decomposePar -fileHandler collated > log.decomposePar 2>&1
  # the section at t = 0, before the solve writes its first
  buoyantPimpleFoam -postProcess -time 0 -dict system/planeFunctions > log.postProcess0 2>&1
)
$setupOnly && { echo "set up, not solved: $r"; exit 0; }

(
  cd "$r"
  mpirun -np "$nproc" buoyantPimpleFoam -parallel -fileHandler collated > log.buoyantPimpleFoam 2>&1
  grep -q '^End' log.buoyantPimpleFoam || { echo "$r: the solve did not end, see log.buoyantPimpleFoam" >&2; exit 1; }
)
echo "solved: $r"
solved() { [ -f "runs/$1/postProcessing/heatAccounting/heat.csv" ]; }
if { solved bare && solved cover; } || { solved finsBare && solved finsFans; }; then
  python3 scripts/extract_results.py runs results
fi
