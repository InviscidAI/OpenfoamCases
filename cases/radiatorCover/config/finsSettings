// -------------------------------------------------------------------------
// finsSettings - what the finsBare and finsFans runs change. Their
// constant/fvOptions and system/controlDict #include caseSettings and then
// this file: its dy replaces caseSettings' fitted one, and its sharedControl
// is merged into caseSettings' entry by entry. The two runs differ only in
// constant/fanSettings (fanOn 1 or 0), which scripts/make_case.py writes.
// -------------------------------------------------------------------------

// ---- the convector's fin channels -------------------------------------------
// Laminar flow between parallel vertical plates 6.31 mm apart (Calisir, Baskaya,
// Yazar and Yucedag 2015's optimum as summarised by Dalkilic et al. 2019; not
// Stelrad's figure), 0.5 mm sheet (ours), porosity phi = 0.927, 0.6 m tall:
// Darcy d_y = 12 / (phi s^2), Forchheimer f_y = 0.674 / (L phi^2) for the
// developing flow (Shah and London's K_inf for plates). Sideways the zone stays
// closed (1e8), as in caseSettings. README.md, "Fans under the radiator".
dy 325267.206791;           // 1/m2; caseSettings' fitted value is 50 times this
fy 1.308411;                // 1/m

// ---- the fins' heat transfer to the air ------------------------------------
// S = hv (55 C - T) on the convector zone's air, W/m3/K. The one fitted setting
// of these runs: bare pilots, 0-40 s, matched to Stelrad's 980 W at dT50 scaled
// by EN 442's exponent 1.3 at the room's mean temperature over 25-40 s, as
// caseSettings' dy was. Frozen for both runs.
hv 448.854950;

// ---- the fans ----------------------------------------------------------------
// meanVelocityForce's target for the fan zone's mean upward cell velocity, m/s,
// set so the air through the zone's bottom face is close to the rated 2 x 30 m3/h
// per metre (16.667 L/s) over 7.5-30 s. Used only when fanOn is 1.
fanUbar 0.233898;

sharedControl
{
 // the fields every 30 s, the last two kept, so that a stopped solve can be
 // continued; both runs were solved in one go
 writeInterval 30;
 purgeWrite 2;
 functions
 {
  // the air through the fan zone's bottom face and the convector's bottom and top,
  // from the face flux phi (kg/s per metre; the faces' normals point up), every 5 steps
  fanInSum   { type surfaceFieldValue; libs (fieldFunctionObjects); regionType faceZone; name fanIn;   operation sum;    fields (phi); writeFields false; log false; writeControl timeStep; writeInterval 5; }
  fanInMag   { type surfaceFieldValue; libs (fieldFunctionObjects); regionType faceZone; name fanIn;   operation sumMag; fields (phi); writeFields false; log false; writeControl timeStep; writeInterval 5; }
  fanInT     { type surfaceFieldValue; libs (fieldFunctionObjects); regionType faceZone; name fanIn;   operation weightedAverage; weightField phi; fields (T rho); writeFields false; log false; writeControl timeStep; writeInterval 5; }
  convInSum  { type surfaceFieldValue; libs (fieldFunctionObjects); regionType faceZone; name convIn;  operation sum;    fields (phi); writeFields false; log false; writeControl timeStep; writeInterval 5; }
  convOutSum { type surfaceFieldValue; libs (fieldFunctionObjects); regionType faceZone; name convOut; operation sum;    fields (phi); writeFields false; log false; writeControl timeStep; writeInterval 5; }
  // the convector zone's mean air temperature, so that the fins' heat can be read
  // directly as hv V (328.15 - <T>), V = 0.0378 m3 per metre
  convT { type volFieldValue; libs (fieldFunctionObjects); regionType cellZone; name convector; operation volAverage; fields (T); writeFields false; log false; writeControl timeStep; writeInterval 5; }
 }
}
