#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")"
layout=${1:-}
usage="usage: ./Allrun positive|negative|even|viewer|twoInTwoOut|aioFrontIn|aioFrontBottomIn|aioRadiatorFront|aioRadiatorTop [dust]"
# ./Allrun <layout> dust: the same layout with two passive dust fields, in runs/<layout>_dust
case "${2:-}" in
  "") run=$layout; dust= ;;
  dust) run=${layout}_dust; dust=--dust ;;
  *) echo "$usage" >&2; exit 2;;
esac
case "$layout" in
  positive|negative|even|twoInTwoOut) [ -d mesh/constant/polyMesh ] || ./Allmesh ;;
  viewer) [ -d mesh/viewer/constant/polyMesh ] || ./Allmesh viewer ;;
  aioFrontIn|aioFrontBottomIn) [ -d mesh/aio/constant/polyMesh ] || ./Allmesh aio ;;
  aioRadiatorFront|aioRadiatorTop) [ -d mesh/pump/constant/polyMesh ] || ./Allmesh pump ;;
  *) echo "$usage" >&2; exit 2;;
esac
python3 scripts/make_case.py "$layout" $dust
cd "runs/$run"
createPatch -overwrite > log.createPatch
checkMesh > log.checkMesh
# Compile the quadratic vent-loss coded boundary once before MPI starts.
pimpleFoam -dry-run > log.dryRun 2>&1 || { cat log.dryRun; exit 1; }
rm -rf 0.00024
decomposePar -fileHandler collated > log.decomposePar
start=$(date +%s)
mpirun -np 8 pimpleFoam -parallel -fileHandler collated > log.pimpleFoam 2>&1
end=$(date +%s)
printf "real_seconds %s\n" "$((end-start))" > wallclock.txt
reconstructPar -latestTime -fileHandler collated > log.reconstructPar
