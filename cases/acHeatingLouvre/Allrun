#!/bin/bash
# A wall-mounted split unit heating a 15 C home office, its vane sending the warm air 15 degrees
# up along the ceiling or 60 degrees down toward the floor, a 3-D half room on the unit's
# centreline from switch-on to 180 s (buoyantPimpleFoam, k-omega SST).
#
#   ./Allrun up|down [nProcs]
#   ./Allrun --setup-only up|down [nProcs]
#
# up            the jet leaves the slot in the unit's front 15 degrees above horizontal.
# down          the jet leaves the slot in the unit's underside 60 degrees below horizontal.
# nProcs        MPI ranks; by default 8, what both solved runs used.
# --setup-only  compiles the wall condition if needed, builds the mesh if needed, writes the run,
#               decomposes it, writes the t = 0 planes and stops before the solve.
#
# Both runs go straight through from rest to 180 s, as the solved runs did.
#
# Every wall, the floor and the ceiling are storedLayerWall79 (src/storedLayerWall79), compiled
# into $FOAM_USER_LIBBIN as libstoredLayerWall79.so. The mesh is shared: the first call builds it
# in runs/mesh/ (scripts/make_mesh.py, blockMesh, a serial snappyHexMesh of a few seconds,
# scripts/unit_patches.py, checkMesh), so start the second run after the first has its mesh.
# scripts/make_case.py writes runs/<run>/ from it, template/ and config/case.json. The jet's
# boundary condition, the monitor and the diagnostic wall-flux observer are coded and compiled
# into the run's dynamicCode when the solve starts. When both runs have solved,
# scripts/extract_results.py writes results/.
cd "${0%/*}" || exit 1
set -euo pipefail
command -v buoyantPimpleFoam > /dev/null || { echo "source OpenFOAM's etc/bashrc first (v2512)" >&2; exit 1; }
command -v wmake > /dev/null || { echo "wmake is needed to compile src/" >&2; exit 1; }
python3 -c "import numpy" 2> /dev/null || { echo "python3 needs NumPy" >&2; exit 1; }

setupOnly=false
if [ "${1:-}" = "--setup-only" ]; then setupOnly=true; shift; fi
run=${1:-}
case "$run" in
  up|down) nproc=${2:-8} ;;
  *) echo "usage: $0 [--setup-only] up|down [nProcs]" >&2; exit 2 ;;
esac

# the wall condition (wmake does nothing if it is up to date)
wmake libso src/storedLayerWall79 > log.wmake.storedLayerWall79 2>&1 \
  || { echo "src/storedLayerWall79 did not compile: log.wmake.storedLayerWall79" >&2; exit 1; }

mesh=runs/mesh
mkdir -p runs
if [ ! -f "$mesh/cells.npz" ]; then
  rm -rf "$mesh"
  python3 scripts/make_mesh.py "$mesh"
  ( cd "$mesh" && blockMesh > log.blockMesh 2>&1 && snappyHexMesh -overwrite > log.snappyHexMesh 2>&1 ) \
    || { echo "$mesh: meshing failed, see its logs" >&2; exit 1; }
  python3 scripts/unit_patches.py "$mesh" > "$mesh/log.unitPatches" 2>&1 \
    || { rm -f "$mesh/cells.npz"; echo "$mesh: the unit's ports did not split, see log.unitPatches" >&2; exit 1; }
  ( cd "$mesh" && checkMesh > log.checkMesh 2>&1 )
  grep -q 'Mesh OK' "$mesh/log.checkMesh" || { rm -f "$mesh/cells.npz"; echo "$mesh: checkMesh failed, see log.checkMesh" >&2; exit 1; }
  grep -E '^ +cells:' "$mesh/log.checkMesh"
fi

r=runs/$run
python3 scripts/make_case.py "$run" "$r" --nprocs "$nproc" --mesh "$mesh"
(
  cd "$r"
  decomposePar -fileHandler collated > log.decomposePar 2>&1
  # the section and the four plans at t = 0, before the solve writes its first
  postProcess -dict system/planesT0 -time 0 -fields '(T U)' > log.planesT0 2>&1
)
$setupOnly && { echo "set up, not solved: $r"; exit 0; }

(
  cd "$r"
  mpirun -np "$nproc" buoyantPimpleFoam -parallel -fileHandler collated > log.buoyantPimpleFoam 2>&1
  grep -q '^End' log.buoyantPimpleFoam || { echo "$r: the solve did not end, see log.buoyantPimpleFoam" >&2; exit 1; }
)
echo "solved: $r"
solved() { [ -f "runs/$1/log.buoyantPimpleFoam" ] && grep -q '^End' "runs/$1/log.buoyantPimpleFoam"; }
if solved up && solved down; then
  python3 scripts/extract_results.py runs results
fi
