#!/bin/bash
# Remove both runs, their meshes and the build logs; the committed inputs and results stay. The
# compiled library and solver in $FOAM_USER_LIBBIN and $FOAM_USER_APPBIN stay too.
cd "${0%/*}" || exit 1
rm -rf runs log.* scripts/__pycache__ src/*/lnInclude src/*/Make/linux* src/*/Make/darwin*
