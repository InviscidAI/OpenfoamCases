FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 0 2 -1 0 0 0 0 ];

internalField   uniform 0;

boundaryField
{
    fan
    {
        type            calculated;
        value           uniform 0;
    }
    vent
    {
        type            calculated;
        value           uniform 0;
    }
    walls
    {
        type            nutkWallFunction;
        blending        stepwise;
        value           uniform 0;
    }
    furniture
    {
        type            nutkWallFunction;
        blending        stepwise;
        value           uniform 0;
    }
    frontAndBack
    {
        type            empty;
    }
}

