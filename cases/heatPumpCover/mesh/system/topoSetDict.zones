FoamFile { format ascii; class dictionary; object topoSetDict; }
// Coil and fan cell zones by cell centre; both boxes lie on cell faces of the refined grid.
actions
(
  { name coil; type cellSet; action new; source boxToCell; box (0.250 0.3125 -1) (0.290 1.0275 0.430); }
  { name coil; type cellZoneSet; action new; source setToCellZone; set coil; }
  { name fan;  type cellSet; action new; source boxToCell; box (0.500 0.315 -1) (0.600 0.960 0.3225); }
  { name fan;  type cellZoneSet; action new; source setToCellZone; set fan; }
);
