FoamFile
{
 version 2.0;
 format ascii;
 class dictionary;
 object fvSolution;
}
solvers
{
 "rho.*" { solver diagonal; }
 p_rgh { solver GAMG; tolerance 1e-7; relTol 0.01; smoother DICGaussSeidel; }
 p_rghFinal { $p_rgh; relTol 0; }
 "(U|e|h|k|omega)" { solver PBiCGStab; preconditioner DILU; tolerance 1e-7; relTol 0.01; }
 "(U|e|h|k|omega)Final" { $U; relTol 0; }
}
PIMPLE
{
 momentumPredictor yes; nOuterCorrectors 2; nCorrectors 2; nNonOrthogonalCorrectors 0; pRefCell 0; pRefValue 100000;
}
