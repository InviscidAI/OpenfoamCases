 #{
 const fvMesh& m=mesh();
 const auto& T=m.lookupObject<volScalarField>("T");
 const auto& rho=m.lookupObject<volScalarField>("rho");
 const auto& phi=m.lookupObject<surfaceScalarField>("phi");
 static label last=-1;label sec=label(std::floor(m.time().value()+1e-8));
 const bool second=sec!=last;last=sec;
 const wordList parts({"topA","topB","topRailA","topRailB","bottomRailA","bottomRailB","grilleA","grilleB"});
 scalarList ba(8,0),bs(8,0),bl(8,GREAT),bh(8,-GREAT);
 forAll(m.boundary(),b)forAll(parts,k)if(m.boundary()[b].name()==parts[k])
 {const auto& tp=T.boundaryField()[b];const auto& a=m.magSf().boundaryField()[b];forAll(tp,j){ba[k]+=a[j];bs[k]+=a[j]*tp[j];bl[k]=min(bl[k],tp[j]);bh[k]=max(bh[k],tp[j]);}}
 forAll(parts,k){reduce(ba[k],sumOp<scalar>());reduce(bs[k],sumOp<scalar>());reduce(bl[k],minOp<scalar>());reduce(bh[k],maxOp<scalar>());}
 if(Pstream::master()){
 fileName dir=m.time().globalPath()/"postProcessing/diagnostics57";mkDir(dir);static bool first=true;std::ofstream out((dir/"baffles.csv").c_str(),first?std::ios::out:std::ios::app);out<<std::setprecision(14);
 if(first){out<<"time,timeIndex";forAll(parts,k)out<<','<<parts[k]<<"Mean_K,"<<parts[k]<<"Min_K,"<<parts[k]<<"Max_K";out<<'\n';}
 out<<m.time().value()<<','<<m.time().timeIndex();forAll(parts,k)out<<','<<bs[k]/max(ba[k],SMALL)<<','<<bl[k]<<','<<bh[k];out<<'\n';first=false;
 }
 if(!second)return true;
 const auto rf=fvc::interpolate(rho);const auto tf=fvc::interpolate(T);
 scalarList flow(24,0); // front,top,above,lateral; each out/in mass,volume,heat
 scalar sm=0,st=0,rm=0,rt=0,gm=0,gt=0,tlo=GREAT,thi=-GREAT;
 forAll(T,i){const vector c=m.C()[i];scalar a=rho[i]*m.V()[i];if(c.x()<.330&&c.y()<.756){sm+=a;st+=a*T[i];}else{rm+=a;rt+=a*T[i];}if(c.x()<.1&&c.y()>.850&&c.y()<2.500){gm+=a;gt+=a*T[i];}tlo=min(tlo,T[i]);thi=max(thi,T[i]);}
 auto addFace=[&](const vector& c,const vector& sf,scalar mf,scalar density,scalar temp,scalar weight){
 label k=-1;scalar sign=0;
 if(mag(c.x()-.330)<1e-7&&c.y()<.756&&mag(sf.x())>SMALL){k=0;sign=sf.x()>0?1:-1;}
 if(mag(c.y()-.756)<1e-7&&c.x()<.330&&mag(sf.y())>SMALL){k=6;sign=sf.y()>0?1:-1;}
 if(mag(c.y()-.900)<1e-7&&c.x()<.330&&mag(sf.y())>SMALL){k=12;sign=sf.y()>0?1:-1;}
 if(mag(c.x()-.450)<1e-7&&c.y()<.900&&mag(sf.x())>SMALL){k=18;sign=sf.x()>0?1:-1;}
 if(k<0)return;scalar mass=weight*mf*sign;label d=mass>=0?0:1;flow[k+d]+=mag(mass);flow[k+2+d]+=mag(mass)/density;flow[k+4+d]+=mag(mass)*1005*(temp-289.15);
 };
 forAll(m.neighbour(),f)addFace(m.Cf()[f],m.Sf()[f],phi[f],rf()[f],tf()[f],1);
 const wordList walls({"floor","ceiling","innerWall","outerWall"});
 scalarList storage(4,0),area(4,0),tsum(4,0),tmin(4,GREAT),tmax(4,-GREAT);
 forAll(m.boundary(),b){const auto& patch=m.boundary()[b];if(patch.type()=="empty")continue;
 if(patch.coupled()){forAll(patch,j)addFace(m.Cf().boundaryField()[b][j],m.Sf().boundaryField()[b][j],phi.boundaryField()[b][j],rf().boundaryField()[b][j],tf().boundaryField()[b][j],.5);continue;}
 forAll(walls,k)if(patch.name()==walls[k]){
 const auto& tp=T.boundaryField()[b];const auto& a=m.magSf().boundaryField()[b];
 OStringStream os;tp.write(os);IStringStream is(os.str());dictionary d(is);
 label n=d.getOrDefault<label>("nLayers",0);scalar capacity=n?d.get<scalar>("rhoCp")*d.get<scalar>("thickness")/n:0;
 for(label l=0;l<n;l++){scalarField layer("layer"+Foam::name(l),d,patch.size());forAll(layer,j)storage[k]+=capacity*a[j]*(layer[j]-289.15);}
 forAll(tp,j){area[k]+=a[j];tsum[k]+=a[j]*tp[j];tmin[k]=min(tmin[k],tp[j]);tmax[k]=max(tmax[k],tp[j]);}
 }}
 forAll(flow,i)reduce(flow[i],sumOp<scalar>());
 forAll(storage,k){reduce(storage[k],sumOp<scalar>());reduce(area[k],sumOp<scalar>());reduce(tsum[k],sumOp<scalar>());reduce(tmin[k],minOp<scalar>());reduce(tmax[k],maxOp<scalar>());}
 reduce(sm,sumOp<scalar>());reduce(st,sumOp<scalar>());reduce(rm,sumOp<scalar>());reduce(rt,sumOp<scalar>());reduce(gm,sumOp<scalar>());reduce(gt,sumOp<scalar>());reduce(tlo,minOp<scalar>());reduce(thi,maxOp<scalar>());
 if(Pstream::master()){
 fileName dir=m.time().globalPath()/"postProcessing/diagnostics57";mkDir(dir);static bool first=true;std::ofstream out((dir/"diagnostics.csv").c_str(),first?std::ios::out:std::ios::app);out<<std::setprecision(14);
 if(first){out<<"time";for(const auto& p:wordList({"front","top","above","lateral"}))out<<','<<p<<"Out_kgs,"<<p<<"In_kgs,"<<p<<"Out_m3s,"<<p<<"In_m3s,"<<p<<"Out_W,"<<p<<"In_W";out<<",cabinetT_K,roomT_K,glassAirT_K,airMin_K,airMax_K,deltaT_s,wall_s";forAll(walls,k)out<<','<<walls[k]<<"Storage_J,"<<walls[k]<<"Mean_K,"<<walls[k]<<"Min_K,"<<walls[k]<<"Max_K";forAll(parts,k)out<<','<<parts[k]<<"Mean_K,"<<parts[k]<<"Min_K,"<<parts[k]<<"Max_K";out<<'\n';}
 out<<m.time().value();forAll(flow,k)out<<','<<flow[k];out<<','<<st/max(sm,SMALL)<<','<<rt/max(rm,SMALL)<<','<<gt/max(gm,SMALL)<<','<<tlo<<','<<thi<<','<<m.time().deltaTValue()<<','<<m.time().elapsedClockTime();forAll(walls,k)out<<','<<storage[k]<<','<<tsum[k]/max(area[k],SMALL)<<','<<tmin[k]<<','<<tmax[k];forAll(parts,k)out<<','<<bs[k]/max(ba[k],SMALL)<<','<<bl[k]<<','<<bh[k];out<<'\n';first=false;
 }
 #};
 }

 heatAccounting
{
 type coded;
 libs (utilityFunctionObjects);
 name heatAccounting;
 executeControl timeStep; executeInterval 1;
 writeControl none;
 codeInclude
 #{
  #include "fvCFD.H"
  #include "turbulentFluidThermoModel.H"
  #include "fvDOM.H"
  #include <fstream>
  #include <iomanip>
 #};
 codeOptions
 #{
  -I$(LIB_SRC)/TurbulenceModels/turbulenceModels/lnInclude -I$(LIB_SRC)/TurbulenceModels/compressible/lnInclude -I$(LIB_SRC)/transportModels/compressible/lnInclude -I$(LIB_SRC)/thermophysicalModels/basic/lnInclude -I$(LIB_SRC)/thermophysicalModels/specie/lnInclude -I$(LIB_SRC)/thermophysicalModels/radiation/lnInclude -I$(LIB_SRC)/surfMesh/lnInclude -I$(LIB_SRC)/parallel/distributed/lnInclude -I$(LIB_SRC)/triSurface/lnInclude
 #};
 codeLibs
 #{
  -lfluidThermophysicalModels -lcompressibleTurbulenceModels -lradiationModels
 #};
 codeExecute
 #{
  const fvMesh& m=mesh();
  if (!m.foundObject<volScalarField>("h")) return true;
  const auto& T=m.lookupObject<volScalarField>("T");
  const auto& p=m.lookupObject<volScalarField>("p");
  const auto& rho=m.lookupObject<volScalarField>("rho");
  const auto& h=m.lookupObject<volScalarField>("h");
  const auto& U=m.lookupObject<volVectorField>("U");
  const auto& phi=m.lookupObject<surfaceScalarField>("phi");
  const auto& turb=m.lookupObject<compressible::turbulenceModel>("turbulenceProperties");
  const auto alpha=turb.alphaEff();
  surfaceScalarField hf(fvc::flux(phi,h,"div(phi,h)"));
  surfaceScalarField df(-fvc::interpolate(alpha())*fvc::snGrad(h)*m.magSf());
  surfaceScalarField rad(IOobject("monitorRad",m.time().timeName(),m,IOobject::NO_READ,IOobject::NO_WRITE,false),m,dimensionedScalar(dimPower,Zero));
  const auto* dom=m.cfindObject<radiation::fvDOM>("radiationProperties");
  if(dom)
  {
   for(label r=0;r<dom->nRay();r++)
   {
    surfaceScalarField Ji(IOobject("monitorJi",m.time().timeName(),m,IOobject::NO_READ,IOobject::NO_WRITE,false),dom->IRay(r).dAve() & m.Sf());
    rad+=fvc::flux(Ji,dom->IRayLambda(r,0),"div(Ji,Ii_h)");
   }
  }
  const auto* qr=m.cfindObject<volScalarField>("qr");
  wordList maskTypes(m.boundary().size(),"zeroGradient");
  forAll(m.boundary(),b) if(m.boundary()[b].coupled() || m.boundary()[b].type()=="empty") maskTypes[b]=m.boundary()[b].type();
  volScalarField z(IOobject("zoneMask",m.time().timeName(),m,IOobject::NO_READ,IOobject::NO_WRITE,false),m,dimensionedScalar(dimless,Zero),maskTypes);
  volScalarField c(IOobject("coverMask",m.time().timeName(),m,IOobject::NO_READ,IOobject::NO_WRITE,false),m,dimensionedScalar(dimless,Zero),maskTypes);
  scalar mass=0,mt=0,energy=0,ez=0,ec=0,kez=0,mz=0,mc=0;
  const scalar R=8314.46261815324/28.96, cv=1005-R;
  forAll(T,i)
  {
   const vector a=m.C()[i];
   z[i]=(a.x()>.120 && a.x()<.228 && a.y()>.078 && a.y()<.660)?1:0;
   c[i]=(a.x()<.330 && a.y()<.756)?1:0;
   mass+=rho[i]*m.V()[i]; mt+=rho[i]*m.V()[i]*T[i];
   scalar e=cv/R*p[i]*m.V()[i];
   energy+=e; ez+=z[i]*e; ec+=c[i]*e;
   kez+=z[i]*.5*rho[i]*magSqr(U[i])*m.V()[i];
   mz+=z[i]*rho[i]*m.V()[i];mc+=c[i]*rho[i]*m.V()[i];
  }
  z.correctBoundaryConditions(); c.correctBoundaryConditions();
  auto gz=fvc::snGrad(z); auto gc=fvc::snGrad(c);
  scalar za=0,zd=0,co=0,ci=0,cd=0,cr=0;
  scalarList openings(12,0);
  auto opening=[&](const vector& at,scalar dc,scalar mass,scalar heat,scalar diff,scalar radiation){
   if(mag(dc)<SMALL)return;
   label k=mag(at.x()-.330)<1e-7?0:6;
   scalar f=dc*mass,a=dc*heat;
   if(f>0){openings[k]+=f;openings[k+2]+=a;}else{openings[k+1]-=f;openings[k+3]-=a;}
   openings[k+4]+=dc*diff;openings[k+5]+=dc*radiation;
  };
  forAll(m.neighbour(),f)
  {
   scalar dz=z[m.owner()[f]]-z[m.neighbour()[f]], dc=c[m.owner()[f]]-c[m.neighbour()[f]];
   za+=dz*hf[f]; zd+=dz*df[f];
   scalar a=dc*hf[f], flux=dc*phi[f];
   if(flux>0)co+=a;else ci-=a;
   cd+=dc*df[f]; cr+=dc*rad[f];
   opening(m.Cf()[f],dc,phi[f],hf[f],df[f],rad[f]);
  }
  scalar panelC=0,panelR=0,mdf=0,coverRad=0;
  scalarList w(10,0);
  const wordList walls({"glass","ceiling","innerWall","floor","outerWall"});
  forAll(m.boundary(),b)
  {
   const auto& patch=m.boundary()[b];
   if(patch.type()=="empty")continue;
   if(patch.coupled())
   {
    const auto zn=z.boundaryField()[b].patchNeighbourField();
    const auto cn=c.boundaryField()[b].patchNeighbourField();
    forAll(patch,j)
    {
     const label cell=patch.faceCells()[j];
     scalar dz=.5*(z[cell]-zn()[j]),dc=.5*(c[cell]-cn()[j]);
     za+=dz*hf.boundaryField()[b][j];zd+=dz*df.boundaryField()[b][j];
     scalar a=dc*hf.boundaryField()[b][j], flux=dc*phi.boundaryField()[b][j];
     if(flux>0)co+=a;else ci-=a;
     cd+=dc*df.boundaryField()[b][j];cr+=dc*rad.boundaryField()[b][j];
     opening(m.Cf().boundaryField()[b][j],dc,phi.boundaryField()[b][j],hf.boundaryField()[b][j],df.boundaryField()[b][j],rad.boundaryField()[b][j]);
    }
    continue;
   }
   scalarField conv(alpha().boundaryField()[b]*h.boundaryField()[b].snGrad()*m.magSf().boundaryField()[b]);
   forAll(patch,j)
   {
    const label cell=patch.faceCells()[j];
    za+=z[cell]*hf.boundaryField()[b][j]; zd-=z[cell]*conv[j];
    scalar radIn=qr ? -qr->boundaryField()[b][j]*m.magSf().boundaryField()[b][j] : 0;
    if(patch.name()=="radiatorPanel"){panelC+=conv[j];panelR+=radIn;}
    forAll(walls,k)if(patch.name()==walls[k]){w[2*k]+=conv[j];w[2*k+1]+=radIn;}
    if(patch.name().ends_with("B")) {mdf+=conv[j];coverRad+=radIn;}

   }
  }
  const auto fluxSum=fvc::surfaceSum(mag(phi));
  scalar coMax=0,uMax=0;vector coAt(Zero),uAt(Zero);
  forAll(T,i)
  {
   scalar ca=.5*m.time().deltaTValue()*fluxSum()[i]/(rho[i]*m.V()[i]);
   if(ca>coMax){coMax=ca;coAt=m.C()[i];}
   if(mag(U[i])>uMax){uMax=mag(U[i]);uAt=m.C()[i];}
  }
  scalar globalCo=coMax,globalU=uMax;reduce(globalCo,maxOp<scalar>());reduce(globalU,maxOp<scalar>());
  if(coMax<globalCo)coAt=Zero;if(uMax<globalU)uAt=Zero;
  reduce(coAt,sumOp<vector>());reduce(uAt,sumOp<vector>());
  scalarList v({mass,mt,energy,ez,ec,kez,za,zd,panelC,panelR,co,ci,cd,cr,mdf,coverRad});
  forAll(v,i)reduce(v[i],sumOp<scalar>());forAll(w,i)reduce(w[i],sumOp<scalar>());
  reduce(mz,sumOp<scalar>());reduce(mc,sumOp<scalar>());forAll(openings,i)reduce(openings[i],sumOp<scalar>());
  if(Pstream::master())
  {
   fileName dir=m.time().globalPath()/"postProcessing/heatAccounting";mkDir(dir);
   static bool first=true;
   std::ofstream out((dir/"heat.csv").c_str(),first?std::ios::out:std::ios::app);
   out<<std::setprecision(14);
   if(first)out<<"time,mass,massT,Uroom,Uzone,Ucover,KEzone,zoneEnthalpy,zoneDiffusion,panelConvection,panelRadiation,coverGrossOut,coverGrossIn,coverDiffusion,coverOpeningRadiation,mdfConvection,mdfRadiation,glassConv,glassRad,ceilingConv,ceilingRad,innerWallConv,innerWallRad,floorConv,floorRad,outerWallConv,outerWallRad,zoneMass,coverMass,maxCo,maxCoX,maxCoY,maxU,maxUX,maxUY,frontOut_kgs,frontIn_kgs,frontOut_W,frontIn_W,frontDiffusion_W,frontRadiation_W,topOut_kgs,topIn_kgs,topOut_W,topIn_W,topDiffusion_W,topRadiation_W\n";
   out<<m.time().value();forAll(v,i)out<<','<<v[i];forAll(w,i)out<<','<<w[i];out<<','<<mz<<','<<mc<<','<<globalCo<<','<<coAt.x()<<','<<coAt.y()<<','<<globalU<<','<<uAt.x()<<','<<uAt.y();forAll(openings,i)out<<','<<openings[i];out<<'\n';
   first=false;
  }
 #};
}

}

}
