label b=m.boundaryMesh().findPatchID("mouth");scalar releasedRate=0;const auto& ph=phi.boundaryField()[b];const auto& cc=c.boundaryField()[b];forAll(ph,i)releasedRate-=ph[i]*cc[i];reduce(releasedRate,sumOp<scalar>());static scalar released=0;released+=releasedRate*m.time().deltaTValue();
