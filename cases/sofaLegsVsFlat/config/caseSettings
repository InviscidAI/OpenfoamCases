 static label last=-1;label sec=label(std::floor(m.time().value()+1e-8));
 if(sec==last)return true;last=sec;
 const auto rf=fvc::interpolate(rho); const auto tf=fvc::interpolate(T);
 scalarList flow(8,0); scalar sm=0,st=0,rv=0,rt=0,tlo=GREAT,thi=-GREAT;
 forAll(T,i){const vector c=m.C()[i];scalar v=m.V()[i];if(c.x()<.273 && c.y()<.70){sm+=rho[i]*v;st+=rho[i]*v*T[i];} if(!(c.x()>.04&&c.x()<.103&&c.y()>.15&&c.y()<.75)){rv+=rho[i]*v;rt+=rho[i]*v*T[i];}tlo=min(tlo,T[i]);thi=max(thi,T[i]);}
