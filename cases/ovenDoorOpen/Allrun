#!/bin/bash
# An electric oven just switched off after roasting at 325 F, its door dropped open or kept shut,
# in a sealed US kitchen at 20 C, a 3-D half kitchen on the range's centreline from switch-off
# to 300 s (buoyantPimpleFoam, k-omega SST).
#
#   ./Allrun open|shut [nProcs]
#   ./Allrun --setup-only open|shut [nProcs]
#
# open          the door down, the cavity's air and its steel liner at 325 F; the liner's stored
#               heat leaves as the solve finds.
# shut          the range a solid block giving a fixed 118.5 W (the half range's) through its front
#               and cooktop: the oven's stored heat given out over an assumed hour.
# nProcs        MPI ranks; by default 8, what both solved runs used.
# --setup-only  compiles the wall condition if needed, builds the run's mesh if needed, writes the
#               run, writes the t = 0 planes, decomposes the run and stops before the solve.
#
# Both runs go straight through from rest to 300 s, as the solved runs did.
#
# The walls, the ceiling, the floor and, in open, the oven's liner are storedLayerWall73
# (src/storedLayerWall73), compiled into $FOAM_USER_LIBBIN as libstoredLayerWall73.so. Each run
# has its own mesh, built in runs/mesh-<run>/ (scripts/make_mesh.py, blockMesh, a serial
# snappyHexMesh of under a minute, scripts/kitchen_patches.py, checkMesh); the two meshes share
# the background, the refinement and every solid but the range. scripts/make_case.py writes
# runs/<run>/ from it, template/ and config/case.json. The monitor is coded and compiled into the
# run's dynamicCode when the solve starts. When both runs have solved,
# scripts/extract_results.py writes results/.
cd "${0%/*}" || exit 1
set -euo pipefail
command -v buoyantPimpleFoam > /dev/null || { echo "source OpenFOAM's etc/bashrc first (v2512)" >&2; exit 1; }
command -v wmake > /dev/null || { echo "wmake is needed to compile src/" >&2; exit 1; }
python3 -c "import numpy" 2> /dev/null || { echo "python3 needs NumPy" >&2; exit 1; }

setupOnly=false
if [ "${1:-}" = "--setup-only" ]; then setupOnly=true; shift; fi
run=${1:-}
case "$run" in
  open|shut) nproc=${2:-8} ;;
  *) echo "usage: $0 [--setup-only] open|shut [nProcs]" >&2; exit 2 ;;
esac

# the wall condition (wmake does nothing if it is up to date)
wmake libso src/storedLayerWall73 > log.wmake.storedLayerWall73 2>&1 \
  || { echo "src/storedLayerWall73 did not compile: log.wmake.storedLayerWall73" >&2; exit 1; }

mesh=runs/mesh-$run
mkdir -p runs
if [ ! -f "$mesh/cells.npz" ]; then
  rm -rf "runs/mesh-$run"
  python3 scripts/make_mesh.py "$run" "$mesh"
  ( cd "$mesh" && blockMesh > log.blockMesh 2>&1 && snappyHexMesh -overwrite > log.snappyHexMesh 2>&1 ) \
    || { echo "$mesh: meshing failed, see its logs" >&2; exit 1; }
  python3 scripts/kitchen_patches.py "$run" "$mesh" > "$mesh/log.kitchenPatches" 2>&1 \
    || { rm -f "$mesh/cells.npz"; echo "$mesh: the kitchen's patches did not sort, see log.kitchenPatches" >&2; exit 1; }
  ( cd "$mesh" && checkMesh > log.checkMesh 2>&1 )
  grep -q 'Mesh OK' "$mesh/log.checkMesh" || { rm -f "$mesh/cells.npz"; echo "$mesh: checkMesh failed, see log.checkMesh" >&2; exit 1; }
  grep -E '^ +cells:' "$mesh/log.checkMesh"
fi

r=runs/$run
python3 scripts/make_case.py "$run" "$r" --nprocs "$nproc" --mesh "$mesh"
(
  cd "$r"
  # the section and the head-height plan at t = 0, before the solve writes its first
  postProcess -dict system/planesT0 -time 0 -fields '(T U)' > log.planesT0 2>&1
  decomposePar -fileHandler collated > log.decomposePar 2>&1
)
$setupOnly && { echo "set up, not solved: $r"; exit 0; }

(
  cd "$r"
  mpirun -np "$nproc" buoyantPimpleFoam -parallel -fileHandler collated > log.buoyantPimpleFoam 2>&1
  grep -q '^End' log.buoyantPimpleFoam || { echo "$r: the solve did not end, see log.buoyantPimpleFoam" >&2; exit 1; }
)
echo "solved: $r"
solved() { [ -f "runs/$1/log.buoyantPimpleFoam" ] && grep -q '^End' "runs/$1/log.buoyantPimpleFoam"; }
if solved open && solved shut; then
  python3 scripts/extract_results.py runs results
fi
